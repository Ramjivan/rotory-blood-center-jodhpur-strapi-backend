{
  "kind": "collectionType",
  "collectionName": "team_members",
  "info": {
    "singularName": "team-member",
    "pluralName": "team-members",
    "displayName": "Team Member",
    "description": "Team members list"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "description": "Full name of the team member."
    },
    "role": {
      "type": "string",
      "required": true,
      "description": "Designation or title (e.g., 'President', 'Medical Officer')."
    },
    "bio": {
      "type": "text",
      "description": "Short biography or description of their responsibilities."
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "description": "Profile picture of the team member."
    },
    "order": {
      "type": "integer",
      "default": 0,
      "description": "Controls display order on the website. Lower numbers (0, 1, 2) appear first."
    }
  }
}
