{
  "kind": "singleType",
  "collectionName": "homepage_stats",
  "info": {
    "singularName": "homepage-stat",
    "pluralName": "homepage-stats",
    "displayName": "Homepage Stat",
    "description": "Stats shown on the homepage like lives saved, active donors, etc."
