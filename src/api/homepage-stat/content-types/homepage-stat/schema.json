      "default": "15,000+"
    },
    "activeDonors": {
      "type": "string",
      "required": true,
      "default": "5,200"
    },
    "thalassemiaWarriors": {
      "type": "string",
      "required": true,
      "default": "120+"
    },
    "topAlertText": {
      "type": "text",
      "default": "🚨 URGENT REQUIREMENT: O-Negative (3 Units) at Main Hospital • A-Positive (2 Units) • Please donate today to save lives! 🚨"
    },
    "showTopAlert": {
      "type": "boolean",
      "default": true
    }
  }
}
